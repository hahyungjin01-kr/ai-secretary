interface ExtractedFile {
    filename: string;
    content: string;
}

function extractFileFromOutput(latestCode: string, arbiterFinal: string, userMessage: string): ExtractedFile {
    const lower = userMessage.toLowerCase();
    let ext = '.txt';
    if (lower.includes('.py') || lower.includes('python')) ext = '.py';
    else if (lower.includes('.ts') || lower.includes('typescript')) ext = '.ts';
    else if (lower.includes('.js') || lower.includes('javascript')) ext = '.js';
    else if (lower.includes('.java')) ext = '.java';
    else if (lower.includes('.go')) ext = '.go';
    else if (lower.includes('.rs') || lower.includes('rust')) ext = '.rs';
    else if (lower.includes('.cpp') || lower.includes('c++')) ext = '.cpp';
    else if (lower.includes('.json')) ext = '.json';
    else if (lower.includes('.yaml') || lower.includes('.yml')) ext = '.yaml';
    else if (lower.includes('.sql')) ext = '.sql';
    else if (lower.includes('.html')) ext = '.html';
    else if (lower.includes('.css')) ext = '.css';
    else if (lower.includes('.sh') || lower.includes('쉘스크립트')) ext = '.sh';
    else if (lower.includes('.csv')) ext = '.csv';
    else if (lower.includes('.md') || lower.includes('마크다운') || lower.includes('블로그') || lower.includes('보고서') || lower.includes('논문') || lower.includes('글') || lower.includes('분석')) ext = '.md';
    
    const ts = new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19);
    const filename = `output_${ts}${ext}`;
    const content = latestCode.trim() !== '' ? latestCode : arbiterFinal;

    return { filename, content };
}

// ─────────────────────────────────────────────
// ✅ 마크다운 코드 블록 깨짐 방지 Splitter 적용
// ─────────────────────────────────────────────
async function sendSplitMessage(channel: any, text: string): Promise<void> {
    if (!text) return;
    const maxLength = 1900;
    const lines = text.split('\n');
    let currentChunk = '';
    let insideCodeBlock = false;
    let currentLanguage = '';
    
    for (const line of lines) {
        if (line.trim().startsWith('```')) {
            insideCodeBlock = !insideCodeBlock;
            if (insideCodeBlock) {
                currentLanguage = line.trim().slice(3).trim();
            } else {
                currentLanguage = '';
            }
        }

        if (currentChunk.length + line.length + 1 > maxLength) {
            if (insideCodeBlock) currentChunk += '\n```';
            await channel.send(currentChunk);
            currentChunk = insideCodeBlock ? `\`\`\`${currentLanguage}\n${line}` : line;
        } else {
            currentChunk += (currentChunk === '' ? '' : '\n') + line;
        }
    }
    
    if (currentChunk) await channel.send(currentChunk);
}

// ─────────────────────────────────────────────
// LLM 통합 호출 함수
// ─────────────────────────────────────────────
async function callLLM(model: string, apiKey: string | undefined, systemPrompt: string, userPrompt: string, history: ChatMessage[] = []): Promise<string> {
    if (!apiKey) return `Error: ${model} API Key가 설정되지 않았습니다.`;
    
    try {
        if (model.includes('gpt')) {
            const client = new OpenAI({ apiKey });
            const messages: any[] = [
                { role: 'system', content: systemPrompt },
                ...history,
                { role: 'user', content: userPrompt }
            ];
            const res = await client.chat.completions.create({ model, messages });
            return res.choices[0]?.message?.content || '';
        } else if (model.includes('claude')) {
            const messages: any[] = [
                ...history.map(m => ({ role: m.role, content: m.content })),
                { role: 'user', content: userPrompt }
            ];
            const res = await fetch('https://api.anthropic.com/v1/messages', {
                method: 'POST',
                headers: {
                    'x-api-key': apiKey,
                    'anthropic-version': '2023-06-01',
                    'content-type': 'application/json',
                    'anthropic-beta': 'prompt-caching-2024-07-31'
                },
                body: JSON.stringify({
                    model, max_tokens: 4096,
                    system: [{ type: 'text', text: systemPrompt, cache_control: { type: 'ephemeral' } }],
                    messages
                })
            });
            const data = await res.json() as any;
            return data.content?.[0]?.text || '';
        } else if (model.includes('gemini')) {
            const genAI = new GoogleGenerativeAI(apiKey);
            const gm = genAI.getGenerativeModel({ model, systemInstruction: systemPrompt });
            if (history.length > 0) {
                const chat = gm.startChat({
                    history: history.map(m => ({
                        role: m.role === 'assistant' ? 'model' : 'user',
                        parts: [{ text: m.content }]
                    }))
                });
                const res = await chat.sendMessage(userPrompt);
                return res.response.text();
            } else {
                const res = await gm.generateContent(userPrompt);
                return res.response.text();
            }
        } else if (model.includes('deepseek')) {
            const client = new OpenAI({ apiKey, baseURL: 'https://api.deepseek.com/v1' });
            const messages: any[] = [
                { role: 'system', content: systemPrompt },
                ...history,
                { role: 'user', content: userPrompt }
            ];
            const res = await client.chat.completions.create({ model: 'deepseek-v4-pro', messages });
            return res.choices[0]?.message?.content || '';
        } else if (model.includes('glm')) {
            const client = new OpenAI({ apiKey, baseURL: 'https://open.bigmodel.cn/api/paas/v4/' });
            const messages: any[] = [
                { role: 'system', content: systemPrompt },
                ...history,
                { role: 'user', content: userPrompt }
            ];
            const res = await client.chat.completions.create({ model, messages });
            return res.choices[0]?.message?.content || '';
        }
    } catch (err: any) {
        console.error(`[${model} 호출 오류]:`, err.message);
        return `Error: ${err.message}`;
    }
    return '';
}

