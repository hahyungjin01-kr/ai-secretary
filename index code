async function sendFileToDiscord(
    channel: any,
    content: string,
    filename: string
): Promise<void> {
    const buffer = Buffer.from(content, 'utf-8');
    await channel.send({
        content: `💾 **[파일 전송 완료]** 아래 파일을 클릭해 다운로드하세요 → \`${filename}\``,
