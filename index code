// ✅ My Computer: 플랫폼별 바탕화면 경로 자동 감지
// ─────────────────────────────────────────────
function getDesktopPath(): string {
    const home = os.homedir();
    if (os.platform() === 'win32') {
        const oneDriveDesktop = path.join(home, 'OneDrive', 'Desktop');
        if (fs.existsSync(oneDriveDesktop)) return oneDriveDesktop;
        return path.join(home, 'Desktop');
    }
    return path.join(home, 'Desktop');
}

// ─────────────────────────────────────────────
// ✅ My Computer: 자율 로컬 파일 스캐너 (내부 시스템 탐색기 최적화)
// ─────────────────────────────────────────────
async function searchAndReadLocalFiles(keyword: string): Promise<{found: boolean, text: string}> {
    const homeDir = os.homedir();
    let cmd = '';
    
    // OS 호환성 대응 및 불필요한 시스템/캐시 폴더 제외 스캔 최적화
    if (os.platform() === 'win32') {
        cmd = `dir "${homeDir}\\*${keyword}*" /s /b /a:-d | findstr /v "node_modules \\.git AppData Local Settings Temp"`;
    } else {
        cmd = `find "${homeDir}" -type f -iname "*${keyword}*" -not -path "*/node_modules/*" -not -path "*/.git/*" -not -path "*/Library/*" -not -path "*/.cache/*" -not -path "*/.npm/*" | head -n 3`;
    }

    try {
        // 10초 타임아웃 락 적용 (전체 디스크 스캔 무한 로딩 방지)
        const result = execSync(cmd, { stdio: ['pipe', 'pipe', 'ignore'], timeout: 10000 }).toString().trim();
        const files = result.split('\n').filter(p => p.trim());
        
        if (files.length === 0) {
            return { found: false, text: `[로컬 탐색 실패] '${keyword}'와 일치하는 파일을 찾을 수 없습니다.`};
        }

        let context = `\n[My Computer - 자동 로컬 파일 탐색 결과 (검색어: ${keyword})]\n`;
        let fetchedCount = 0;
        
        for (let i = 0; i < Math.min(files.length, 2); i++) {
            const filePath = files[i].trim();
            context += `\n▶ 찾은 파일 시스템 경로: ${filePath}\n`;
            try {
                const fileStat = await fsp.stat(filePath);
                if (fileStat.size > 200000) {
                    context += `(파일 크기가 초과되어 생략됨: ${fileStat.size} bytes)\n`;
                    continue;
                }
                const fileContent = await fsp.readFile(filePath, 'utf-8');
                context += `\`\`\`\n${fileContent.slice(0, 15000)}${fileContent.length > 15000 ? '\n...[파일이 길어 생략됨]' : ''}\n\`\`\`\n`;
                fetchedCount++;
            } catch(err: any) {
                context += `(읽기 권한 거부 또는 실패: ${err.message})\n`;
            }
        }
        return { found: fetchedCount > 0, text: context };
    } catch (err: any) {
        return { found: false, text: `[로컬 탐색 중단] 탐색 중 에러 또는 타임아웃 발생 (너무 넓은 범위 검색)`};
    }
}

