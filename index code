async function handleMessageEvent(message: Message): Promise<void> {
    if (message.author.bot) return;
    const channelId = message.channel.id;
    const content   = message.content.trim();
    const masterId  = process.env.DISCORD_OWNER_ID?.trim();

    if (content === '그만' || content === '!stop') {
        const ctrl = abortControllers.get(channelId);
        if (ctrl && !ctrl.signal.aborted) {
            ctrl.abort();
            return void message.reply('🛑 **중단 요청을 받았습니다.**');
        } else {
            return void message.reply('ℹ️ 현재 진행 중인 작업이 없습니다.');
        }
    }

    if (content === '!history clear' || content === '!대화초기화') {
        clearHistory(channelId);
        return void message.reply('🗑️ **대화 히스토리가 초기화되었습니다.** (최근 10턴 기억이 삭제됨)');
    }

    if (content === '!history' || content === '!히스토리') {
        const turns = Math.floor(getHistory(channelId).length / 2);
        return void message.reply(`📜 **현재 저장된 대화:** ${turns}턴 / 최대 ${MAX_HISTORY_TURNS}턴`);
    }

    if (content === '!moa on')  { moaState[channelId] = true;  return void message.reply('🟢 MoA 활성화'); }
    if (content === '!moa off') { moaState[channelId] = false; return void message.reply('🔴 MoA 비활성화'); }
    if (content.startsWith('!')) return;

    const config = getConfigForChannel(channelId);
    if (!config) return;

    if (activeTasks.has(channelId)) return;
    activeTasks.add(channelId);

    const abortCtrl = new AbortController();
    abortControllers.set(channelId, abortCtrl);
    const signal = abortCtrl.signal;

    try {
        const ownerChannel    = await ownerBot.channels.fetch(channelId)    as any;
        const reviewerChannel = await reviewerBot.channels.fetch(channelId) as any;
        const arbiterChannel  = await arbiterBot.channels.fetch(channelId)  as any;

        const attachments = [...message.attachments.values()];
        let attachedFileContext = '';
        let attachedLocalPaths: string[] = [];

        // 1. 파일 첨부 처리
        if (attachments.length > 0) {
            await ownerChannel.send(`📎 **[My Computer]** 첨부 파일 ${attachments.length}개를 감지했습니다. 내용을 읽는 중...`);
            for (const attachment of attachments) {
                try {
                    const { content: fileContent, filename, localPath } = await myComputerReadAttachment(attachment);
                    attachedLocalPaths.push(localPath);
                    attachedFileContext += `\n\n${'─'.repeat(40)}\n📄 [첨부 파일: ${filename}]\n${'─'.repeat(40)}\n${fileContent}`;
                    await ownerChannel.send(`✅ **[My Computer]** \`${filename}\` 읽기 완료`);
                } catch (err: any) {
                    await ownerChannel.send(`⚠️ **[My Computer]** \`${attachment.name}\` 읽기 실패: ${err.message}`);
                }
            }
        }

        // 2. 외부 링크(URL) 처리 - 깃허브 코드 추출 포함
        const urlRegex = /(https?:\/\/[^\s]+)/g;
        const urls = content.match(urlRegex);
        let urlContext = '';

        if (urls && urls.length > 0) {
            await ownerChannel.send(`🔗 **[Web Fetcher]** ${urls.length}개의 외부 링크를 감지했습니다. 데이터를 추출합니다...`);
            for (let url of urls) {
                try {
                    let fetchUrl = url;
                    // 깃허브 코드(blob) 링크인 경우 raw 텍스트를 가져오도록 변환
                    if (fetchUrl.includes('github.com') && fetchUrl.includes('/blob/')) {
                        fetchUrl = fetchUrl.replace('github.com', 'raw.githubusercontent.com').replace('/blob/', '/');
                    }

                    const res = await fetch(fetchUrl);
                    if (!res.ok) throw new Error(`HTTP ${res.status}`);
                    
                    let text = await res.text();
                    const contentType = res.headers.get('content-type') || '';
                    
                    // 일반 웹페이지(HTML)인 경우 간단한 태그 제거
                    if (contentType.includes('text/html') && !fetchUrl.includes('raw.githubusercontent')) {
                        text = text.replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
                                   .replace(/<style\b[^<]*(?:(?!<\/style>)<[^<]*)*<\/style>/gi, '')
                                   .replace(/<[^>]+>/g, '\n')
                                   .replace(/\n\s+\n/g, '\n\n');
                    }

                    const MAX_URL_CONTENT_LENGTH = 150000;
                    if (text.length > MAX_URL_CONTENT_LENGTH) {
                        text = text.slice(0, MAX_URL_CONTENT_LENGTH) + `\n\n... [내용이 너무 길어 앞 ${MAX_URL_CONTENT_LENGTH}자만 전달합니다.]`;
                    }

                    urlContext += `\n\n${'─'.repeat(40)}\n🌐 [외부 링크: ${url}]\n${'─'.repeat(40)}\n${text}`;
                    await ownerChannel.send(`✅ **[Web Fetcher]** \`${url}\` 읽기 완료`);
                } catch (err: any) {
                    await ownerChannel.send(`⚠️ **[Web Fetcher]** \`${url}\` 접근 실패: ${err.message}`);
                }
            }
        }

        const intention = analyzeFileIntention(content, attachments.length > 0);

        let modePrompts: any = PROMPTS.MODE_1;
        if (config.name.includes('주식'))     modePrompts = PROMPTS.MODE_2;
        if (config.name.includes('블로그'))   modePrompts = PROMPTS.MODE_3;
        if (config.name.includes('논문'))     modePrompts = PROMPTS.MODE_4;
        if (config.name.includes('자료 조사')) modePrompts = PROMPTS.MODE_5;

        const arbiterPrompt = modePrompts.ARBITER ?? PROMPTS.ARBITER;
        const moaPrompt     = modePrompts.MOA     ?? PROMPTS.MOA;

        let stockContext = '';
        if (config.name.includes('주식')) {
            const today = new Date();
            const dateStr = today.toLocaleDateString('ko-KR', {
                year: 'numeric', month: 'long', day: 'numeric', weekday: 'long'
            });

            try {
                await ownerChannel.send(`🔍 **[데이터 수집]** 실시간 재무 및 기술적 지표를 동기화합니다...`);

                const tickerMatch = content.match(/[A-Za-z]{1,10}/) || content.match(/\d{6}/) || content.match(/[가-힣]+/);
                
                if (!tickerMatch) {
                    await ownerChannel.send(`⚠️ **[검색 실패]** 분석할 주식 종목(티커 또는 종목명)이 감지되지 않았습니다.\n분석을 원하시면 종목명이나 코드를 명확히 포함하여 다시 질문해 주세요. (예: AAPL, 삼성전자, 005930)`);
                    return; 
                } else {
                    const query = tickerMatch[0];
                    const searchResult = await yahooFinance.search(query);
                    
                    const topMatch = searchResult.quotes.find((q: any) => q.isYahooFinance === true || q.quoteType === 'EQUITY' || q.quoteType === 'ETF') || searchResult.quotes[0];

                    if (!topMatch || !topMatch.symbol) {
                        await ownerChannel.send(`⚠️ **[검색 실패]** '${query}'에 해당하는 유효한 주식 종목을 찾지 못했습니다.\n정확한 종목 코드(티커)나 풀네임을 확인 후 다시 입력해 주세요. (예: TSLA, 005930)`);
                        return; 
                    }

                    const symbol = topMatch.symbol;
                    
                    const quote = await yahooFinance.quote(symbol) as any;

                    const endDate = new Date();
                    const startDate = new Date();
                    startDate.setDate(endDate.getDate() - 100);
                    const historical = await yahooFinance.historical(symbol, {
                        period1: startDate, period2: endDate, interval: '1d'
                    });

                    const quoteSummary = await yahooFinance.quoteSummary(symbol, {
                        modules: ['summaryDetail', 'defaultKeyStatistics', 'financialData']
                    }).catch(() => null);

                    stockContext = `\n\n[실시간 시장 및 재무 데이터 (조회일: ${dateStr})]\n` +
                        `- 종목명: ${quote.longName || quote.shortName} (${symbol})\n` +
                        `- 현재가: ${quote.regularMarketPrice} ${quote.currency || ''}\n` +
                        `- 52주 최고/최저: ${quote.fiftyTwoWeekHigh} / ${quote.fiftyTwoWeekLow}\n` +
                        `- 거래량: ${quote.regularMarketVolume}\n`;

                    if (quoteSummary) {
                        const sd = quoteSummary.summaryDetail || {};
                        const ks = quoteSummary.defaultKeyStatistics || {};
                        const fd = quoteSummary.financialData || {};

                        const formatValue = (val: any) => val ? val.toLocaleString() : 'N/A';
                        const formatPercent = (val: any) => val ? (val * 100).toFixed(2) + '%' : 'N/A';

                        stockContext += `- 시가총액: ${formatValue(sd.marketCap)}\n` +
                            `- PER (Trailing): ${formatValue(sd.trailingPE)}, PER (Forward): ${formatValue(sd.forwardPE)}\n` +
                            `- PBR: ${formatValue(ks.priceToBook)}\n` +
                            `- EPS (Trailing): ${formatValue(ks.trailingEps)}, EPS (Forward): ${formatValue(ks.forwardEps)}\n` +
                            `- ROE: ${formatPercent(fd.returnOnEquity)}\n` +
                            `- 총매출: ${formatValue(fd.totalRevenue)}, 영업이익률: ${formatPercent(fd.operatingMargins)}\n`;
                    }

                    if (historical.length > 0) {
                        const closes = historical.map((d: any) => d.close);
                        const rsiResult = RSI.calculate({ values: closes, period: 14 });
                        const currentRsi = rsiResult.length > 0 ? rsiResult[rsiResult.length - 1] : null;
                        const bbResult = BollingerBands.calculate({ period: 20, values: closes, stdDev: 2 });
                        const currentBb = bbResult.length > 0 ? bbResult[bbResult.length - 1] : null;

                        stockContext += `- 최근 RSI (14일): ${currentRsi !== null ? (currentRsi as number).toFixed(2) : 'N/A'}\n`;
                        if (currentBb) {
                            stockContext += `- 볼린저 밴드 (20일): 상단 ${currentBb.upper.toFixed(2)}, 중간 ${currentBb.middle.toFixed(2)}, 하단 ${currentBb.lower.toFixed(2)}\n`;
                        }
                    }

                    stockContext += `\n[핵심 지시사항]: 1STEP(재무제표) 및 2STEP(밸류에이션) 분석 시 반드시 위 [실시간 시장 및 재무 데이터]의 수치만을 사용하라. 제공되지 않은 과거 연도의 수치를 임의로 지어내어 분석하는 행위를 엄격히 금지한다.`;

                    await ownerChannel.send(`✅ **[데이터 수집 완료]** ${symbol} 종목의 최신 펀더멘털 및 기술적 데이터를 프롬프트에 주입했습니다.`);
                }
            } catch (err: any) {
                console.error('주식 데이터 조회 실패:', err.message);
                await ownerChannel.send(`⚠️ **[API 오류]** 종목 데이터 조회 중 오류가 발생했습니다. 종목 코드(티커)가 유효한지 확인하고 잠시 후 다시 시도해 주세요.`);
                return; 
            }
        }

        let attempt = 0;
        const MAX_RETRIES = 3;
        let isApproved = false;
        let isUserStopped = false;
        let latestCode = '';
        let latestFeedback = content;

        if (masterId && message.author.id === masterId && content.includes('강제승인')) {
            await arbiterChannel.send(`🙆‍♂️ **[${config.name}]** 방장 다이렉트 오더. 리뷰를 생략합니다.`);
            isApproved = true;
        }

        const history = getHistory(channelId);

        while (attempt < MAX_RETRIES && !isApproved) {
            if (signal.aborted) { isUserStopped = true; break; }
            attempt++;

            let ownerInput: string;
            if (attempt === 1) {
                ownerInput = `[작업 지시]: ${latestFeedback}`;
                if (attachedFileContext) ownerInput += `\n\n[My Computer - 첨부 파일 내용]\n아래는 사용자가 첨부한 파일이다.\n${attachedFileContext}`;
                if (urlContext) ownerInput += `\n\n[Web Fetcher - 외부 링크 내용]\n아래는 사용자가 공유한 외부 링크의 내용이다. 코드가 포함된 경우 변형 없이 원본을 참조하라.\n${urlContext}`;
                if (stockContext) ownerInput += stockContext;
                if (intention.wantsFileEdit && attachedLocalPaths.length > 0)
                    ownerInput += `\n\n[My Computer - 수정 모드]\n첨부 파일을 수정한 결과만 태그 안에 전체 출력하라. 새 파일을 만들지 마라.`;
            } else {
                ownerInput = `[최근 피드백을 반영해 수정하세요]:\n${latestFeedback}`;
            }

            await ownerChannel.sendTyping();
            const ownerRaw = await callLLM(
                config.owner.model,
                config.owner.key,
                modePrompts.OWNER,
                ownerInput,
                attempt === 1 ? history : []
            );

            if (attempt === 1) {
                appendHistory(channelId, 'user', ownerInput);
                appendHistory(channelId, 'assistant', ownerRaw);
            }

            const codeMatch     = ownerRaw.match(/<CODE>([\s\S]*?)<\/CODE>/s);
            const analysisMatch = ownerRaw.match(/<ANALYSIS>([\s\S]*?)<\/ANALYSIS>/s);

            if (codeMatch)          latestCode = codeMatch[1].trim();
            else if (analysisMatch) latestCode = analysisMatch[1].trim();
            else                    latestCode = ownerRaw.trim();

            await ownerChannel.send(`**(Owner 시도 ${attempt}/${MAX_RETRIES})**`);
            await sendSplitMessage(ownerChannel, `\`\`\`\n${latestCode}\n\`\`\``);

            if (signal.aborted) { isUserStopped = true; break; }

            await reviewerChannel.sendTyping();
            const reviewerRaw = await callLLM(config.reviewer.model, config.reviewer.key, modePrompts.REVIEWER, `[Owner 제출물]:\n<CODE>\n${latestCode}\n</CODE>`);

            if (signal.aborted) { isUserStopped = true; break; }

            if (reviewerRaw.includes('PASS') || reviewerRaw.includes('DONE')) {
                await reviewerChannel.send('✅ **(Reviewer)**: PASS. 승인합니다.');
                isApproved = true;
            } else {
                const feedbackMatch = reviewerRaw.match(/<FEEDBACK>([\s\S]*?)<\/FEEDBACK>/s);
                latestFeedback = feedbackMatch ? feedbackMatch[1].trim() : reviewerRaw.trim();
                await reviewerChannel.send('⚠️ **(Reviewer 피드백)**:');
                await sendSplitMessage(reviewerChannel, latestFeedback);
                if (attempt >= MAX_RETRIES) break;
            }
        }

        if (isUserStopped) {
            const stopMsg = latestCode.trim() !== ''
               ? `🛑 **(Owner)** 사용자 요청으로 모든 작업이 중단되었습니다.\n\n중단 시점까지 생성된 결과물은 아래와 같습니다:\n\`\`\`\n${latestCode}\n\`\`\``
                : `🛑 **(Owner)** 사용자 요청으로 모든 작업이 중단되었습니다.\n생성된 결과물이 없습니다.`;
            await sendSplitMessage(ownerChannel, stopMsg);
            return; 
        }

        let arbiterInputContext = `[요청]: ${content}\n[최종 결과물]:\n${latestCode}\n`;
        const shouldRunMoA = isApproved && moaState[channelId];

        if (shouldRunMoA && config.moa && config.moa.length > 0) {
            await arbiterChannel.send(`🧠 **[MoA 가동 중]** 외부 모델에 집단지성 검증을 요청합니다...`);
            const moaResults = await Promise.all(
                config.moa.map((m: any) => callLLM(m.model, m.key, moaPrompt, `[결과물]:\n${latestCode}`))
            );
            if(moaResults.length > 0) arbiterInputContext += `\n[MoA 1 의견]:\n${moaResults[0]}`;
            if(moaResults.length > 1) arbiterInputContext += `\n[MoA 2 의견]:\n${moaResults[1]}`;
        }

        await arbiterChannel.sendTyping();
        const arbiterFinal = await callLLM(config.arbiter.model, config.arbiter.key, arbiterPrompt, arbiterInputContext);
        await arbiterChannel.send('👑 **(Arbiter 최종 판정)**:');
        await sendSplitMessage(arbiterChannel, arbiterFinal);

        if (intention.wantsFileEdit && attachedLocalPaths.length > 0) {
            await ownerChannel.send(`📨 **(Owner → My Computer)** 원본 파일을 수정된 내용으로 덮어씁니다...`);
            try {
                const editFilename = path.basename(attachedLocalPaths[0]);
                await sendFileToDiscord(ownerChannel, latestCode, editFilename);
            } catch (err: any) {
                await ownerChannel.send(`❌ 파일 전송 실패: ${err.message}`);
            }
        } else if (intention.wantsFileOutput) {
            await ownerChannel.send(`📨 **(Owner → My Computer)** 결과물을 파일로 생성하여 저장합니다...`);
            try {
                const { filename, content: fileContent } = extractFileFromOutput(latestCode, arbiterFinal, content);
                const finalFilename = intention.suggestedFilename ?? filename;
                await sendFileToDiscord(ownerChannel, fileContent, finalFilename);
            } catch (err: any) {
                await ownerChannel.send(`❌ 파일 전송 실패: ${err.message}`);
            }
        } else {
            await ownerChannel.send(`📨 **(Owner → 사용자 전달)** 최종 산출물은 아래와 같습니다.`);
        }

    } catch (error) {
        console.error('❌ 파이프라인 에러:', error);
    } finally {
        abortControllers.delete(channelId);
        activeTasks.delete(channelId);
    }
}

// ─────────────────────────────────────────────
// 봇 시작
// ─────────────────────────────────────────────
async function startSwarms(): Promise<void> {
    const yf = await import('yahoo-finance2') as any;
    const YahooFinanceClass = yf.YahooFinance ?? yf.default?.YahooFinance ?? yf.default;
    yahooFinance = (typeof YahooFinanceClass === 'function')
        ? new YahooFinanceClass()
        : YahooFinanceClass;

    const tokenMap: Record<string, string | undefined> = {
        DISCORD_OWNER_TOKEN:    process.env.DISCORD_OWNER_TOKEN,
        DISCORD_REVIEWER_TOKEN: process.env.DISCORD_REVIEWER_TOKEN,
        DISCORD_ARBITER_TOKEN:  process.env.DISCORD_ARBITER_TOKEN,
    };
    const missingTokens = Object.entries(tokenMap)
       .filter(([, v]) => !v || typeof v !== 'string' || v.trim() === '')
       .map(([k]) => k);
    if (missingTokens.length > 0) {
        console.error('❌ 아래 환경 변수가 .env 파일에 없거나 비어 있습니다:');
        missingTokens.forEach(k => console.error(`   - ${k}`));
        console.error('💡 .env 파일을 열어 올바른 Discord 봇 토큰을 입력한 뒤 다시 실행하세요.');
        process.exit(1);
    }

    ownerBot.on(Events.MessageCreate, handleMessageEvent);
    reviewerBot.on(Events.MessageCreate, handleMessageEvent);
    arbiterBot.on(Events.MessageCreate, handleMessageEvent);

    await Promise.all([
        ownerBot.login(process.env.DISCORD_OWNER_TOKEN!),
        reviewerBot.login(process.env.DISCORD_REVIEWER_TOKEN!),
        arbiterBot.login(process.env.DISCORD_ARBITER_TOKEN!),
    ]);

    console.log('👥 4채널 Tribunal + MoA + Web Fetcher 시스템 가동 완료.');
}

startSwarms();
