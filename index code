// ─────────────────────────────────────────────
// 메인 메시지 이벤트 핸들러
// ─────────────────────────────────────────────
async function handleMessageEvent(message: Message): Promise<void> {
    if (message.author.bot) return;
    const channelId = message.channel.id;
    const content = message.content.trim();
    const masterId = process.env.DISCORD_OWNER_ID?.trim();
    
    if (content === '그만' || content === '!stop') {
        const ctrl = abortControllers.get(channelId);
        if (ctrl && !ctrl.signal.aborted) {
            ctrl.abort();
            return void message.reply('🛑 **중단 요청을 받았습니다.**');
        } else {
            return void message.reply('ℹ️ 현재 진행 중인 작업이 없습니다.');
        }
    }

    if (content === '!history clear' || content === '!대화초기화') {
        clearHistory(channelId);
        return void message.reply('🗑️ **대화 히스토리가 초기화되었습니다.** (최근 10턴 기억이 삭제됨)');
    }

    if (content === '!history' || content === '!히스토리') {
        const turns = Math.floor(getHistory(channelId).length / 2);
        return void message.reply(`📜 **현재 저장된 대화:** ${turns}턴 / 최대 ${MAX_HISTORY_TURNS}턴`);
    }

    if (content === '!moa on') { moaState[channelId] = true; return void message.reply('🟢 MoA 활성화'); }
    if (content === '!moa off') { moaState[channelId] = false; return void message.reply('🔴 MoA 비활성화'); }
    if (content.startsWith('!')) return;

    const config = getConfigForChannel(channelId);
    if (!config) return;

    if (activeTasks.has(channelId)) return;
    activeTasks.add(channelId);
    const abortCtrl = new AbortController();
    abortControllers.set(channelId, abortCtrl);
    const signal = abortCtrl.signal;
    
    try {
        const ownerChannel = await ownerBot.channels.fetch(channelId) as any;
        const reviewerChannel = await reviewerBot.channels.fetch(channelId) as any;
        const arbiterChannel = await arbiterBot.channels.fetch(channelId) as any;

        const attachments = [...message.attachments.values()];
        let attachedFileContext = '';
        let attachedLocalPaths: string[] = [];

        // ✅ 1. 자율 로컬 파일 검색 시스템 (파일 찾아줘, 검색해줘 등 감지)
        const searchKeywordMatch = content.match(/([a-zA-Z0-9_.-가-힣]+)\s*(파일|문서).*?(찾아|검색|불러와|읽어|어디)/i);
        if (searchKeywordMatch) {
            const keyword = searchKeywordMatch[1];
            await ownerChannel.send(`🔍 **[My Computer]** 사용자의 지시에 따라 로컬 파일 시스템에서 \`${keyword}\` 파일을 자율 탐색합니다...`);
            const searchResult = await searchAndReadLocalFiles(keyword);
            
            attachedFileContext += `\n\n${searchResult.text}`;
            if (searchResult.found) {
                await ownerChannel.send(`✅ **[My Computer]** 로컬 파일 탐색 및 내용 추출 완료`);
            } else {
                await ownerChannel.send(`⚠️ **[My Computer]** 로컬 디렉토리에서 지정한 파일을 찾지 못했습니다.`);
            }
        }

        // ✅ 2. 파일 첨부 병렬 파싱 시스템 (속도 최적화)
        if (attachments.length > 0) {
            await ownerChannel.send(`📎 **[My Computer]** 첨부 파일 ${attachments.length}개를 감지했습니다. 병렬 파싱을 시작합니다...`);
            
            const attachmentPromises = attachments.map(async (attachment) => {
                try {
                    const { content: fileContent, filename, localPath } = await myComputerReadAttachment(attachment);
                    attachedLocalPaths.push(localPath);
                    // AI가 코드를 누락된 것으로 오해하지 않도록 강력한 경고 주입
                    const formattedContext = `\n\n${'─'.repeat(40)}\n📄 [첨부 파일: ${filename}]\n⚠️ [시스템 강력 경고]: 아래 제공되는 파일의 내용은 절대로 중간에 잘리거나 누락된 것이 아닌, 100% 완벽한 전체 코드/문서입니다. "코드가 불완전하다"거나 "나머지 부분을 제공해달라"고 판단하는 오류(할루시네이션)를 절대 범하지 마십시오. 전체 구조를 완벽히 숙지하십시오.\n${'─'.repeat(40)}\n${fileContent}`;
                    return { success: true, filename, context: formattedContext };
                } catch (err: any) {
                    return { success: false, filename: attachment.name, error: err.message };
                }
            });

            const results = await Promise.all(attachmentPromises);
            for (const res of results) {
                if (res.success) {
                    attachedFileContext += res.context;
                    await ownerChannel.send(`✅ **[My Computer]** \`${res.filename}\` 파싱 완료`);
                } else {
                    await ownerChannel.send(`⚠️ **[My Computer]** \`${res.filename}\` 읽기 실패: ${res.error}`);
                }
            }
        }

        // ✅ 3. Web Fetcher 병렬 크롤링 및 403 우회 강화
        const urlRegex = /(https?:\/\/[^\s]+)/g;
        const urls = content.match(urlRegex);
        let urlContext = '';

        if (urls && urls.length > 0) {
            await ownerChannel.send(`🔗 **[Web Fetcher]** ${urls.length}개의 외부 링크를 감지했습니다. 병렬 데이터 추출을 시작합니다...`);
            
            const urlPromises = urls.map(async (url) => {
                try {
                    let fetchUrl = url;
                    if (fetchUrl.includes('github.com') && fetchUrl.includes('/blob/')) {
                        fetchUrl = fetchUrl.replace('github.com', 'raw.githubusercontent.com').replace('/blob/', '/');
                    }

                    // User-Agent 헤더 주입으로 웹 서버의 Bot 차단(403 Forbidden) 회피
                    const res = await fetch(fetchUrl, {
                        headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36' }
                    });
                    if (!res.ok) throw new Error(`HTTP ${res.status}`);
                    
                    let text = await res.text();
                    const contentType = res.headers.get('content-type') || '';
                    if (contentType.includes('text/html') && !fetchUrl.includes('raw.githubusercontent')) {
                        text = text.replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
                                   .replace(/<style\b[^<]*(?:(?!<\/style>)<[^<]*)*<\/style>/gi, '')
                                   .replace(/<[^>]+>/g, '\n')
                                   .replace(/\n\s+\n/g, '\n\n');
                    }

                    const MAX_URL_CONTENT_LENGTH = 150000;
                    if (text.length > MAX_URL_CONTENT_LENGTH) {
                        text = text.slice(0, MAX_URL_CONTENT_LENGTH) + `\n\n... [내용이 너무 길어 앞 ${MAX_URL_CONTENT_LENGTH}자만 전달합니다.]`;
                    }
                    return { success: true, url, text: `\n\n${'─'.repeat(40)}\n🌐 [외부 링크: ${url}]\n${'─'.repeat(40)}\n${text}` };
                } catch (err: any) {
                    return { success: false, url, error: err.message };
                }
            });

            const webResults = await Promise.all(urlPromises);
            for (const res of webResults) {
                if (res.success) {
                    urlContext += res.text;
                    await ownerChannel.send(`✅ **[Web Fetcher]** \`${res.url}\` 읽기 완료`);
                } else {
                    await ownerChannel.send(`⚠️ **[Web Fetcher]** \`${res.url}\` 접근 실패: ${res.error}`);
                }
            }
        }

        const intention = analyzeFileIntention(content, attachments.length > 0);
        let modePrompts: any = PROMPTS.MODE_1;
        
        if (config.name.includes('주식')) modePrompts = PROMPTS.MODE_2;
        if (config.name.includes('블로그')) modePrompts = PROMPTS.MODE_3;
        if (config.name.includes('논문')) modePrompts = PROMPTS.MODE_4;
        if (config.name.includes('자료 조사')) modePrompts = PROMPTS.MODE_5;

        const arbiterPrompt = modePrompts.ARBITER ?? PROMPTS.ARBITER;
        const moaPrompt = modePrompts.MOA ?? PROMPTS.MOA;

        let stockContext = '';
        if (config.name.includes('주식')) {
            const today = new Date();
            const currentYear = today.getFullYear();
            const dateStr = today.toLocaleDateString('ko-KR', {
                year: 'numeric', month: 'long', day: 'numeric', weekday: 'long'
            });
            
            try {
                await ownerChannel.send(`🔍 **[의도 분석]** 요청하신 주식 종목을 파악하고 있습니다...`);
                
                const extractionSystemPrompt = `사용자의 질문에서 주식 종목명이나 티커만 추출하세요.
- 특정 종목이 지정되었다면 해당 종목명만 쉼표로 구분하여 출력 (예: 삼성전자, AAPL)
- 추천 요청이면 현재 유망한 주식 3개를 골라 쉼표로 구분하여 출력
- 무관한 질문이면 NONE 출력
- 다른 설명, 인사말, 마크다운 기호는 절대 추가하지 마세요.`;
                
                let extractedRaw = await callLLM(config.owner.model, config.owner.key, extractionSystemPrompt, `[사용자 메시지]: ${content}`);
                
                if (extractedRaw.startsWith('Error:')) {
                    extractedRaw = content; 
                }

                let cleanExtracted = extractedRaw.replace(/```[a-zA-Z]*\n?/g, '').replace(/```/g, '').replace(/["']/g, '');
                if (cleanExtracted.includes('\n')) cleanExtracted = cleanExtracted.split('\n')[0]; 
                cleanExtracted = cleanExtracted.replace(/[^A-Za-z0-9가-힣,\s]/g, '').trim();

                if (cleanExtracted.toUpperCase().includes('NONE') || cleanExtracted === '') {
                    await ownerChannel.send(`⚠️ **[실시간 데이터 미지원]** 특정 종목이 명시되지 않아 실시간 데이터를 수집할 수 없습니다. 과거 시장 데이터를 바탕으로 거시적 관점의 분석 및 전략을 제공합니다.`);
                    stockContext = `\n\n[시스템 경고]: 사용자가 특정 종목을 지정하지 않아 실시간 주식 데이터를 제공하지 못했습니다.
과거 데이터를 마치 현재(${currentYear}년)의 가격이나 수치인 것처럼 임의로 지어내어 대답하는 것을 엄격히 금지합니다.
"특정 종목을 지정해주시면 실시간 데이터를 분석해 드립니다"라고 명시한 뒤, 현재 시장의 매크로 트렌드나 일반적인 투자 전략, 섹터 전망 위주로 답변을 진행하세요. 특정 종목을 추천할 경우 가격은 생략하세요.`;
                } else {
                    const stocks = cleanExtracted.split(',').map(s => s.trim()).filter(s => s.length > 0).slice(0, 3);
                    await ownerChannel.send(`🔍 **[데이터 수집]** 감지된 종목(${stocks.join(', ')})의 실시간 재무, 기술적 지표 및 최신 뉴스를 동기화합니다...`);
                    
                    stockContext = `\n\n[실시간 시장 및 재무 데이터 (조회일: ${dateStr})]\n`;
                    let fetchedCount = 0;

                    for (let stock of stocks) {
                        const safeQuery = stock.replace(/[^A-Za-z0-9가-힣\s]/g, '').trim();
                        if (!safeQuery) continue;

                        try {
                            const searchResult = await yahooFinance.search(safeQuery);
                            const topMatch = searchResult?.quotes?.find((q: any) => q.isYahooFinance === true || q.quoteType === 'EQUITY' || q.quoteType === 'ETF') || searchResult?.quotes?.[0];

                            if (topMatch && topMatch.symbol) {
                                const symbol = topMatch.symbol;
