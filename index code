function getStrictTimeEnforcement(): string {
    const today = new Date();
    const currentYear = today.getFullYear();
    const dateStr = today.toLocaleDateString('ko-KR', {
        year: 'numeric', month: 'long', day: 'numeric', weekday: 'long'
    });
    return `\n[시스템 필수 지시사항: 현재 기준 날짜는 무조건 ${dateStr}입니다. LLM의 학습 데이터(지식 컷오프) 한계로 인해 과거 연도(${currentYear - 1}년, ${currentYear - 2}년 등)를 현재로 착각하여 언급하거나 기준으로 삼는 것을 '절대' 금지합니다. 모든 분석과 서술은 ${currentYear}년 현재 시점을 기준으로 작성해야 합니다.]\n`;
}

