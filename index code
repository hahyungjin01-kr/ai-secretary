interface FileIntention {
    wantsFileOutput: boolean;
    wantsFileEdit: boolean;
    savePath?: string;
    suggestedFilename?: string;
}

function analyzeFileIntention(userContent: string, hasAttachments: boolean): FileIntention {
    const lower = userContent.toLowerCase();
    const editKeywords = ['수정', '편집', '고쳐', '바꿔', '변경', '업데이트', '수정해줘', '수정해 줘', 'edit', 'modify', 'update', 'fix', 'change', 'revise', 'rewrite'];
    const wantsFileEdit = hasAttachments && editKeywords.some(k => lower.includes(k));

    const createKeywords = ['파일로', '파일 만들', '저장해', '저장 해', '만들어줘', '만들어 줘', '생성해', '작성해줘', '작성해 줘', '문서로', '코드 짜줘', '코드 작성', '파일로 저장', '파일로 만들', '파일로 출력', 'save', 'create file', 'write file', 'generate file', 'export to file'];
    const wantsFileOutput = createKeywords.some(k => lower.includes(k));

    let savePath: string | undefined;
    const absPathMatch = userContent.match(/(?:에|에다가|으로|로|in|to|at)\s+([A-Za-z]:\\[^\s]+|\/[^\s]+|~\/[^\s]*)/);
    
    if (absPathMatch) savePath = absPathMatch[1];
    else if (lower.includes('다운로드')) savePath = path.join(os.homedir(), 'Downloads');
    else if (lower.includes('문서')) savePath = path.join(os.homedir(), 'Documents');
    else if (lower.includes('바탕화면') || lower.includes('데스크탑') || lower.includes('desktop')) savePath = getDesktopPath();
    
    const filenameMatch = userContent.match(/["']([^"']+\.[a-zA-Z0-9]{1,10})["']/) || userContent.match(/(\S+\.(txt|md|py|js|ts|json|csv|xlsx|docx|pdf|html|css|sh|yaml|yml|sql|java|cpp|go|rs))\b/i);
    const suggestedFilename = filenameMatch ? filenameMatch[1] : undefined;

    return { wantsFileOutput, wantsFileEdit, savePath, suggestedFilename };
}

