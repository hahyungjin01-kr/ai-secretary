                                const endDate = new Date();
                                const startDate = new Date();
                                startDate.setDate(endDate.getDate() - 100);
                                const historical = await yahooFinance.historical(symbol, { period1: startDate, period2: endDate, interval: '1d' }).catch(() => []);
                                const quoteSummary = await yahooFinance.quoteSummary(symbol, { modules: ['summaryDetail', 'defaultKeyStatistics', 'financialData'] }).catch(() => null);
                                
                                let newsText = '';
                                if (searchResult.news && searchResult.news.length > 0) {
                                    newsText = searchResult.news.slice(0, 3).map((n: any) => `  * ${n.title}`).join('\n');
                                }

                                stockContext += `\n▶ [${quote.longName || quote.shortName} (${symbol})]\n`;
                                stockContext += `- 현재가: ${quote.regularMarketPrice} ${quote.currency || ''}\n`;
                                stockContext += `- 52주 최고/최저: ${quote.fiftyTwoWeekHigh} / ${quote.fiftyTwoWeekLow}\n`;
                                stockContext += `- 거래량: ${quote.regularMarketVolume}\n`;
                                
                                if (quoteSummary) {
                                    const sd = quoteSummary.summaryDetail || {};
                                    const ks = quoteSummary.defaultKeyStatistics || {};
                                    const fd = quoteSummary.financialData || {};
                                    const formatValue = (val: any) => val ? val.toLocaleString() : 'N/A';
                                    const formatPercent = (val: any) => val ? (val * 100).toFixed(2) + '%' : 'N/A';
                                    stockContext += `- 시가총액: ${formatValue(sd.marketCap)}, PER: ${formatValue(sd.trailingPE)}, PBR: ${formatValue(ks.priceToBook)}, ROE: ${formatPercent(fd.returnOnEquity)}\n`;
                                }
                                
                                if (historical.length > 0) {
                                    const closes = historical.map((d: any) => d.close);
                                    const rsiResult = RSI.calculate({ values: closes, period: 14 });
                                    const currentRsi = rsiResult.length > 0 ? rsiResult[rsiResult.length - 1] : null;
                                    stockContext += `- 최근 RSI (14일): ${currentRsi !== null ? (currentRsi as number).toFixed(2) : 'N/A'}\n`;
                                }
                                
                                stockContext += `- 최신 관련 뉴스 헤드라인:\n${newsText || '  (최신 뉴스 없음)'}\n`;
                                fetchedCount++;
                            }
                        } catch (err: any) {
                            console.error(`[${safeQuery}] 종목 데이터 조회 실패:`, err.message);
