// ✅ 일반 메시지 분할 전송 (1900자 제한 처리)
// ─────────────────────────────────────────────
async function sendSplitMessage(channel: any, text: string): Promise<void> {
    if (!text) return;
    const maxLength = 1900;
    const lines = text.split('\n');
    let currentChunk = '';
    let insideCodeBlock = false;
    let currentLanguage = '';
    
    for (const line of lines) {
        if (line.trim().startsWith('```')) {
            insideCodeBlock = !insideCodeBlock;
            if (insideCodeBlock) {
                currentLanguage = line.trim().slice(3).trim();
            } else {
                currentLanguage = '';
            }
        }

        if (currentChunk.length + line.length + 1 > maxLength) {
            if (insideCodeBlock) currentChunk += '\n```';
            await channel.send(currentChunk);
            currentChunk = insideCodeBlock ? `\`\`\`${currentLanguage}\n${line}` : line;
        } else {
            currentChunk += (currentChunk === '' ? '' : '\n') + line;
        }
    }
    
    if (currentChunk) await channel.send(currentChunk);
}

// ─────────────────────────────────────────────
// ✅ 스마트 메시지 샌더 (대규모 텍스트 강제 파일 변환 쉴드)
// ─────────────────────────────────────────────
async function sendSmartMessage(channel: any, text: string, filenamePrefix: string, isCode: boolean = true): Promise<void> {
    if (!text) return;
    const LARGE_THRESHOLD = 15000; 
    
    if (text.length >= LARGE_THRESHOLD) {
        const buffer = Buffer.from(text, 'utf-8');
        const prompt = `[필수 지시사항 - 반드시 읽을 것]\n\n첨부 파일은 약 ${text.length}자의 완성된 소스 코드입니다.\n이 코드는 절대 잘리거나 누락된 것이 아닙니다.\n\n① 첨부 파일 전체를 끝까지 읽어주세요.\n② 읽기가 완료되면 "전체 코드 파악 완료"라고만 답해주세요.\n③ 내가 수정 요청을 할 때까지 절대 먼저 코드를 수정하지 마세요.\n④ 중간에 "코드가 없는 것 같습니다" 또는 "불완전합니다" 라고 \n   판단하지 마세요. 파일 전체가 하나의 완성본입니다.`;
        
        const ext = isCode ? '.ts' : '.md';
        await channel.send({
            content: prompt,
            files: [{ attachment: buffer, name: `${filenamePrefix}_${Date.now()}${ext}` }]
        });
    } else {
        if (isCode) {
            await sendSplitMessage(channel, `\`\`\`typescript\n${text}\n\`\`\``);
        } else {
            await sendSplitMessage(channel, text);
        }
    }
}

// ─────────────────────────────────────────────
// ✅ LLM 통합 호출 함수 (재시도 로직 및 o1/o3 호환 적용)
// ─────────────────────────────────────────────
async function callLLM(model: string, apiKey: string | undefined, systemPrompt: string, userPrompt: string, history: ChatMessage[] = [], retries: number = 3): Promise<string> {
    if (!apiKey) return `Error: ${model} API Key가 설정되지 않았습니다.`;
    
    let attempt = 0;
    while (attempt < retries) {
        try {
            if (model.includes('gpt') || model.includes('o1') || model.includes('o3')) {
                const client = new OpenAI({ apiKey });
                const messages: any[] = [];
                
                if (model.includes('o1') || model.includes('o3')) {
                    messages.push({ role: 'user', content: `[System Instructions]\n${systemPrompt}` });
                    messages.push(...history);
                    messages.push({ role: 'user', content: userPrompt });
                } else {
                    messages.push({ role: 'system', content: systemPrompt });
                    messages.push(...history);
                    messages.push({ role: 'user', content: userPrompt });
                }
                
                const res = await client.chat.completions.create({ model, messages });
                return res.choices[0]?.message?.content || '';
            } else if (model.includes('claude')) {
                const messages: any[] = [
                    ...history.map(m => ({ role: m.role, content: m.content })),
                    { role: 'user', content: userPrompt }
                ];
                const res = await fetch('https://api.anthropic.com/v1/messages', {
                    method: 'POST',
                    headers: {
                        'x-api-key': apiKey,
                        'anthropic-version': '2023-06-01',
                        'content-type': 'application/json',
                        'anthropic-beta': 'prompt-caching-2024-07-31'
                    },
                    body: JSON.stringify({
                        model, max_tokens: 4096,
                        system: [{ type: 'text', text: systemPrompt, cache_control: { type: 'ephemeral' } }],
                        messages
                    })
                });
                const data = await res.json() as any;
                if (data.error) throw new Error(data.error.message);
                return data.content?.[0]?.text || '';
            } else if (model.includes('gemini')) {
                const genAI = new GoogleGenerativeAI(apiKey);
                const gm = genAI.getGenerativeModel({ model, systemInstruction: systemPrompt });
                if (history.length > 0) {
                    const chat = gm.startChat({
                        history: history.map(m => ({
                            role: m.role === 'assistant' ? 'model' : 'user',
                            parts: [{ text: m.content }]
                        }))
                    });
                    const res = await chat.sendMessage(userPrompt);
                    return res.response.text();
                } else {
                    const res = await gm.generateContent(userPrompt);
                    return res.response.text();
                }
            } else if (model.includes('deepseek')) {
                const client = new OpenAI({ apiKey, baseURL: 'https://api.deepseek.com/v1' });
                const messages: any[] = [
                    { role: 'system', content: systemPrompt },
                    ...history,
                    { role: 'user', content: userPrompt }
                ];
                const res = await client.chat.completions.create({ model, messages });
                return res.choices[0]?.message?.content || '';
            } else if (model.includes('glm')) {
                const client = new OpenAI({ apiKey, baseURL: 'https://open.bigmodel.cn/api/paas/v4/' });
                const messages: any[] = [
                    { role: 'system', content: systemPrompt },
                    ...history,
                    { role: 'user', content: userPrompt }
                ];
                const res = await client.chat.completions.create({ model, messages });
                return res.choices[0]?.message?.content || '';
            }
        } catch (err: any) {
            attempt++;
            console.error(`[${model} 호출 오류 (시도 ${attempt}/${retries})]:`, err.message);
            if (attempt >= retries) {
                return `Error: ${err.message}`;
            }
            // 엑스포넨셜 백오프(Exponential Backoff) 적용: 1초, 2초, 4초 대기 후 재시도
            await new Promise(resolve => setTimeout(resolve, Math.pow(2, attempt) * 1000));
        }
    }
    return '';
}

