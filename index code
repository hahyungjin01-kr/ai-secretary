1. 현재 연도는 ${currentYear}년입니다.
2. 당신의 과거 학습 데이터(작년 등)를 기반으로 기업의 경쟁력이나 시장 동향을 서술하는 것은 치명적인 오류(할루시네이션)입니다.
3. 기업의 현황은 오직 위에 제공된 [최신 관련 뉴스 헤드라인]과 [실시간 재무 데이터]만을 근거로 분석하십시오.
4. 만약 제공된 데이터나 뉴스만으로 충분한 분석이 어렵다면, 과거 정보를 지어내지 말고 "최신 세부 정보 부족으로 제한적 분석을 제공합니다"라고 솔직하게 명시하십시오.`;
                        await ownerChannel.send(`✅ **[수집 완료]** ${fetchedCount}개 종목의 최신 펀더멘털 데이터 및 뉴스 헤드라인을 프롬프트에 주입했습니다.`);
                    }
                }
            } catch (err: any) {
                console.error('주식 데이터 프로세스 오류:', err.message);
                await ownerChannel.send(`⚠️ **[API 오류]** 데이터 수집 중 오류가 발생하여 기본 분석 모드로 전환합니다.`);
            }
        }

        let attempt = 0;
        const MAX_RETRIES = 6;
        let isApproved = false;
        let isUserStopped = false;
        let latestCode = '';
        let latestFeedback = content;
        
        if (masterId && message.author.id === masterId && content.includes('강제승인')) {
            await arbiterChannel.send(`🙆‍♂️ **[${config.name}]** 방장 다이렉트 오더. 리뷰를 생략합니다.`);
            isApproved = true;
        }

        const history = getHistory(channelId);
        
        while (attempt < MAX_RETRIES && !isApproved) {
            if (signal.aborted) { isUserStopped = true; break; }
            attempt++;

            let ownerInput: string;
            if (attempt === 1) {
                ownerInput = `[작업 지시]: ${latestFeedback}`;
                if (attachedFileContext) ownerInput += `\n\n[My Computer - 문서 및 로컬 파일 컨텍스트]\n${attachedFileContext}`;
                if (urlContext) ownerInput += `\n\n[Web Fetcher - 외부 링크 내용]\n아래는 사용자가 공유한 외부 링크의 내용이다. 코드가 포함된 경우 변형 없이 원본을 참조하라.\n${urlContext}`;
                if (stockContext) ownerInput += stockContext;
                
                if (intention.wantsFileOutput) {
                    ownerInput += `\n\n[My Computer - 포맷 출력 강제 모드]\n사용자가 결과물을 특정 파일 형태로 출력하거나 저장하길 원합니다. 서론이나 부연 설명 없이, 파일에 저장될 결과물 본문만 코드 블록에 정확히 담아 출력하십시오.`;
                } else if (intention.wantsFileEdit && attachedLocalPaths.length > 0) {
                    ownerInput += `\n\n[My Computer - 수정 모드]\n첨부 파일을 수정한 결과만 태그 안에 전체 출력하라. 새 파일을 만들지 마라.`;
                }
            } else {
                ownerInput = `[최근 피드백을 반영해 수정하세요]:\n${latestFeedback}`;
            }

            await ownerChannel.sendTyping();
            const ownerRaw = await callLLM(config.owner.model, config.owner.key, modePrompts.OWNER, ownerInput, attempt === 1 ? history : []);

            if (attempt === 1) {
                appendHistory(channelId, 'user', ownerInput);
                appendHistory(channelId, 'assistant', ownerRaw);
            }

            const codeMatch = ownerRaw.match(/<CODE>([\s\S]*?)<\/CODE>/s);
            const analysisMatch = ownerRaw.match(/<ANALYSIS>([\s\S]*?)<\/ANALYSIS>/s);

            if (codeMatch) latestCode = codeMatch[1].trim();
            else if (analysisMatch) latestCode = analysisMatch[1].trim();
            else latestCode = ownerRaw.trim();
            
            await ownerChannel.send(`**(Owner 시도 ${attempt}/${MAX_RETRIES})**`);
            
            await sendSmartMessage(ownerChannel, latestCode, 'owner_code', true);

            if (signal.aborted) { isUserStopped = true; break; }

            if (latestCode.includes("전체 코드 파악 완료")) {
                await ownerChannel.send('✅ **[시스템 바이패스 발동]** 전체 코드 파악 피드백을 확인했습니다. 불필요한 리뷰어 평가를 생략하고 즉시 대기 모드로 전환합니다.');
                isApproved = true;
                break; 
            }

            await reviewerChannel.sendTyping();
            const reviewerRaw = await callLLM(config.reviewer.model, config.reviewer.key, modePrompts.REVIEWER, `[Owner 제출물]:\n<CODE>\n${latestCode}\n</CODE>`);

            if (signal.aborted) { isUserStopped = true; break; }

            if (reviewerRaw.includes('PASS') || reviewerRaw.includes('DONE')) {
                await reviewerChannel.send('✅ **(Reviewer)**: PASS. 승인합니다.');
                isApproved = true;
            } else {
                const feedbackMatch = reviewerRaw.match(/<FEEDBACK>([\s\S]*?)<\/FEEDBACK>/s);
                latestFeedback = feedbackMatch ? feedbackMatch[1].trim() : reviewerRaw.trim();
                await reviewerChannel.send('⚠️ **(Reviewer 피드백)**:');
                await sendSplitMessage(reviewerChannel, latestFeedback);
                if (attempt >= MAX_RETRIES) break;
            }
        }

        if (isUserStopped) {
            const stopMsg = latestCode.trim() !== '' 
                ? `🛑 **(Owner)** 사용자 요청으로 모든 작업이 중단되었습니다.\n\n중단 시점까지 생성된 결과물은 아래와 같습니다:\n\`\`\`\n${latestCode}\n\`\`\``
                : `🛑 **(Owner)** 사용자 요청으로 모든 작업이 중단되었습니다.\n생성된 결과물이 없습니다.`;
            await sendSplitMessage(ownerChannel, stopMsg);
            return; 
        }

        let arbiterInputContext = `[요청]: ${content}\n[최종 결과물]:\n${latestCode}\n`;
        const shouldRunMoA = isApproved && moaState[channelId] && !latestCode.includes("전체 코드 파악 완료"); 

        if (shouldRunMoA && config.moa && config.moa.length > 0) {
            await arbiterChannel.send(`🧠 **[MoA 가동 중]** 외부 모델에 집단지성 검증을 요청합니다...`);
            const moaResults = await Promise.all(
                config.moa.map((m: any) => callLLM(m.model, m.key, moaPrompt, `[결과물]:\n${latestCode}`))
            );
            if(moaResults.length > 0) arbiterInputContext += `\n[MoA 1 의견]:\n${moaResults[0]}`;
            if(moaResults.length > 1) arbiterInputContext += `\n[MoA 2 의견]:\n${moaResults[1]}`;
        }

        let arbiterFinal: string | undefined;

        if (!latestCode.includes("전체 코드 파악 완료")) {
            await arbiterChannel.sendTyping();
            arbiterFinal = await callLLM(config.arbiter.model, config.arbiter.key, arbiterPrompt, arbiterInputContext);
            
            await arbiterChannel.send('👑 **(Arbiter 최종 판정)**:');
            await sendSmartMessage(arbiterChannel, arbiterFinal, 'arbiter_final', false);
        }

        // ✅ 파일 수정 / 강제 변환 포맷 저장 프로세스
        if (intention.wantsFileOutput || (intention.wantsFileEdit && attachedLocalPaths.length > 0)) {
            const targetCode = latestCode.includes("전체 코드 파악 완료") ? latestCode : (arbiterFinal ? arbiterFinal : latestCode);
            const { filename, content: fileContent } = extractFileFromOutput(latestCode, targetCode, content, intention.forcedExtension);
            
            let finalFilename = intention.suggestedFilename ?? filename;
            
            if (intention.savePath) {
                try {
                    await ownerChannel.send(`📨 **(Owner → My Computer)** 지정된 로컬 경로(\`${intention.savePath}\`)로 파일 직접 저장을 시도합니다...`);
                    await fsp.mkdir(intention.savePath, { recursive: true });
                    const fullPath = path.join(intention.savePath, finalFilename);
                    await fsp.writeFile(fullPath, fileContent, 'utf-8');
                    await ownerChannel.send(`✅ **[My Computer]** 사용자 지정 디렉토리에 파일이 성공적으로 생성되었습니다: \`${fullPath}\``);
                    
                    await sendFileToDiscord(ownerChannel, fileContent, finalFilename);
                } catch (err: any) {
                    await ownerChannel.send(`❌ 로컬 파일 직접 저장 실패: ${err.message}\n(디스코드 파일 전송으로 대체합니다.)`);
                    await sendFileToDiscord(ownerChannel, fileContent, finalFilename);
                }
            } else {
                await ownerChannel.send(`📨 **(Owner → My Computer)** 결과물을 사용자 지정 포맷 파일로 렌더링하여 전송합니다...`);
                await sendFileToDiscord(ownerChannel, fileContent, finalFilename);
            }
        } else {
            await ownerChannel.send(`📨 **(Owner → 사용자 전달)** 최종 산출물 처리가 완료되었습니다.`);
        }

    } catch (error) {
        console.error('❌ 파이프라인 에러:', error);
    } finally {
        abortControllers.delete(channelId);
        activeTasks.delete(channelId);
    }
}

