    });
}

// ─────────────────────────────────────────────
// ✅ My Computer: Discord 첨부파일 읽기
// ─────────────────────────────────────────────
async function myComputerReadAttachment(attachment: Attachment): Promise<{ content: string; filename: string; localPath: string; }> {
    const filename = attachment.name ?? 'unknown_file';
    const ext = path.extname(filename).toLowerCase();
    const tmpDir = path.join(os.tmpdir(), 'discord_bot_uploads');
    
    await fsp.mkdir(tmpDir, { recursive: true });
    const localPath = path.join(tmpDir, `${Date.now()}_${filename}`);
    const res = await fetch(attachment.url);
    
    if (!res.ok) throw new Error(`파일 다운로드 실패: ${res.statusText}`);
    const buffer = Buffer.from(await res.arrayBuffer());
    await fsp.writeFile(localPath, buffer);

    let content = '';
    const textExts = [
        '.txt', '.md', '.log', '.csv', '.tsv', '.json', '.jsonl',
        '.js', '.ts', '.py', '.java', '.c', '.cpp', '.cs', '.go',
        '.rs', '.rb', '.php', '.html', '.css', '.xml', '.yaml', '.yml',
        '.sh', '.bat', '.ps1', '.env', '.ini', '.toml', '.sql'
    ];

    try {
        if (textExts.includes(ext)) {
            content = await fsp.readFile(localPath, 'utf-8');
        } else if (['.docx', '.odt', '.rtf'].includes(ext)) {
            try {
                const mammoth = require('mammoth');
                const result = await mammoth.extractRawText({ path: localPath });
                content = result.value;
            } catch {
                content = `[.docx 추출 실패: npm install mammoth 후 재시도하세요.\n경로: ${localPath}]`;
            }
        } else if (['.xlsx', '.xlsm', '.pptx', '.epub'].includes(ext)) {
            try {
                const XLSX = require('xlsx');
                const wb = XLSX.readFile(localPath);
                content = wb.SheetNames.map((n: string) => `[Sheet: ${n}]\n${XLSX.utils.sheet_to_csv(wb.Sheets[n])}`).join('\n\n');
            } catch {
                content = `[.xlsx 추출 실패: npm install xlsx 후 재시도하세요.\n경로: ${localPath}]`;
            }
        } else if (ext === '.pdf') {
            content = execSync(`pdftotext "${localPath}" -`, { maxBuffer: 10 * 1024 * 1024 }).toString();
        } else if (['.jpg', '.jpeg', '.png', '.gif', '.webp', '.bmp', '.tiff', '.tif'].includes(ext)) {
            const ocrApiKey = process.env.GEMINI_OCR_API_KEY || process.env.GEMINI_MOA_API_KEY;
            
            if (!ocrApiKey) {
                content = `[이미지 OCR 실패: .env에 GEMINI_OCR_API_KEY 또는 GEMINI_MOA_API_KEY를 설정하세요.]`;
            } else {
                try {
                    const mimeTypeMap: Record<string, string> = {
                        '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg', '.png': 'image/png', '.gif': 'image/gif',
                        '.webp': 'image/webp', '.bmp': 'image/bmp', '.tiff': 'image/tiff', '.tif': 'image/tiff',
                    };
                    const mimeType = mimeTypeMap[ext] ?? 'image/jpeg';
                    const imageBytes = await fsp.readFile(localPath);
                    const base64Image = imageBytes.toString('base64');
                    const { GoogleGenerativeAI } = require('@google/generative-ai');
                    const genAI = new GoogleGenerativeAI(ocrApiKey);
                    const visionModel = genAI.getGenerativeModel({ model: 'gemini-3.1-pro-preview' });
                    
                    const ocrResult = await visionModel.generateContent([
                        { inlineData: { data: base64Image, mimeType } },
                        `이 이미지에 포함된 모든 텍스트를 빠짐없이 추출해서 원문 그대로 출력해주세요. 텍스트가 한국어·영어·혼합 등 어떤 언어든 그대로 출력하세요. 텍스트 외에 표·도표·그래프가 있으면 구조를 설명해주세요. 텍스트가 전혀 없는 이미지라면 이미지 내용을 상세히 설명해주세요.`
                    ]);
                    content = `[Gemini Vision OCR - ${filename}]\n` + ocrResult.response.text();
                } catch (ocrErr: any) {
                    content = `[이미지 OCR 오류: ${ocrErr.message}]`;
                }
            }
        } else {
            content = `[지원되지 않는 파일 형식: ${ext}.\n로컬 경로: ${localPath}]`;
        }
    } catch (err: any) {
        content = `[파일 내용 추출 중 오류: ${err.message}.\n로컬 경로: ${localPath}]`;
    }

    const MAX_CONTENT_LENGTH = 150000;
    if (content.length > MAX_CONTENT_LENGTH) {
        content = content.slice(0, MAX_CONTENT_LENGTH) + `\n\n... [파일 내용이 길어 앞 ${MAX_CONTENT_LENGTH}자만 전달합니다.\n전체 파일은 로컬에 저장되어 있습니다.]`;
    }
    return { content, filename, localPath };
}

// ─────────────────────────────────────────────
// ✅ My Computer: 사용자 요청 의도 분석
