# 토스증권 Open API
# 발급: 토스증권 WTS/앱 → 설정 → Open API
# 문서: https://developers.tossinvest.com/docs
# 중요: 허용 IP를 등록해야 호출됩니다.

TOSS_CLIENT_ID=your_client_id
TOSS_CLIENT_SECRET=your_client_secret

# 선택: 사용할 계좌의 accountSeq (GET /api/v1/accounts 응답 값)
# 비우면 BROKERAGE 계좌를 자동 선택합니다.
# TOSSINVEST_ACCOUNT=1

# PORT=8787

# 공개 URL 보호 (설정 시 변경 API에 X-Traders-Token 필요)
# TRADERS_AI_TOKEN=long-random-string

# 리스크·검증 (수익 보장 아님)
# MIN_PAPER_TRADE_DAYS=10
# MIN_PAPER_CALENDAR_DAYS=14
# DAILY_LOSS_LIMIT_PCT=3
# MAX_CONSECUTIVE_LOSSES=3
# FORCE_PAPER=1

# 모바일 고정 주소 (localtunnel 서브도메인)
PUBLIC_TUNNEL_SUBDOMAIN=traders-ai-toss

# 더 안정적인 고정 URL이 필요하면 ngrok 무료 계정 토큰 사용
# https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=xxxx.ngrok-free.app
