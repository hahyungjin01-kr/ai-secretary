# Alpaca broker (US stocks)
# 1) https://app.alpaca.markets 에서 API Key 발급
# 2) 아래 값을 traders-ai/.env 에 복사 (절대 git에 올리지 마세요)

ALPACA_API_KEY=your_key_id
ALPACA_API_SECRET=your_secret_key

# 기본: 페이퍼 계좌
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# 실계좌를 쓰려면 아래 중 하나:
# ALPACA_LIVE=true
# ALPACA_BASE_URL=https://api.alpaca.markets

# PORT=8787
