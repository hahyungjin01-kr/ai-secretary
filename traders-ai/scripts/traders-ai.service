[Unit]
Description=Traders AI (Docker Compose always-on)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/traders-ai
# tunnel 프로필 포함 (NGROK_* 가 .env 에 있을 때)
ExecStart=/usr/bin/docker compose --profile tunnel up -d --build
ExecStop=/usr/bin/docker compose --profile tunnel down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
